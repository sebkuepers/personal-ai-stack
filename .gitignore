# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual envs
.venv/
venv/
env/

# Node / Cloudflare (mcp-server, cron)
node_modules/
.wrangler/
.dev.vars
worker-configuration.d.ts

# Secrets / local env — never commit these
.env
.env.*
!.env.example
.dev.vars.*

# Arbeitsdaten der Workflows (Manuskript-Exporte, Entscheidungslog, Patches).
# Enthält unveröffentlichten Werktext — gehört nicht ins Repo.
workflows/data/

# Work configurations and voice profiles: chapter plans, touchstones, publishing
# strategy and evidence quotes from unpublished manuscripts. This repo is public —
# the DOMAIN (code, agents, docs) is shared, the WORK stays local.
# shared/book/*.example.json serves as the template.
shared/book/*.json
shared/book/*.md
!shared/book/*.example.json
# These eval cases are constructed and contain no manuscript text.
!shared/book/eval-second-read.json
!shared/book/eval-copyedit.json
!shared/book/eval-style.json

# Same guard for the inbox domain: anything derived from the real mailbox —
# sender statistics, dossiers, eval cases built from real envelopes — carries
# correspondents' addresses. Only the constructed cases are released.
shared/inbox/*.json
shared/inbox/*.md
!shared/inbox/eval-review.json

# The finance domain is the strictest of the three: shared/finance/ holds the
# paths to the author's statements, his account names and his IBANs, and
# workflows/data/finance/ holds the ledger itself — every booking he ever made.
# None of that belongs in a public repo. Only the template and the CONSTRUCTED
# eval cases (invented merchants, invented amounts) are released.
shared/finance/*.json
shared/finance/*.md
!shared/finance/paths.example.json
!shared/finance/eval-categorise.json

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.log

# OS / editor cruft
.DS_Store
.idea/
.vscode/

# Rohmitschnitte der interaktiven CLI — enthalten Manuskripttext
workflows/sse_events_*.sse.log
