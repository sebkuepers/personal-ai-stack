# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual envs
.venv/
venv/
env/

# Node / Cloudflare (mcp-server, cron)
node_modules/
.wrangler/
.dev.vars
worker-configuration.d.ts

# Secrets / local env — never commit these
.env
.env.*
!.env.example
.dev.vars.*

# Arbeitsdaten der Workflows (Manuskript-Exporte, Entscheidungslog, Patches).
# Enthält unveröffentlichten Werktext — gehört nicht ins Repo.
workflows/data/

# Werk-Konfigurationen und Stimmprofile: Kapitelpläne, Prüfsteine, Verlagsstrategie
# und Belegzitate aus unveröffentlichten Manuskripten. Dieses Repo ist öffentlich —
# die DOMÄNE (Code, Agents, Doku) wird geteilt, das WERK bleibt lokal.
# Als Vorlage dient shared/buch/*.example.json.
shared/buch/*.json
shared/buch/*.md
!shared/buch/*.example.json
# Judge-Testfälle sind konstruiert und enthalten keinen Werktext.
!shared/buch/eval-judge.json

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.log

# OS / editor cruft
.DS_Store
.idea/
.vscode/
